APP_NAME=TicketingArchitecture
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ticketing
DB_USERNAME=ticketing
DB_PASSWORD=ticketing

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

TICKETING_RATE_LIMIT_READ=180
TICKETING_RATE_LIMIT_INDEX=140
TICKETING_RATE_LIMIT_SHOW=260
TICKETING_RATE_LIMIT_COMMENTS=160
TICKETING_RATE_LIMIT_WRITE=70
TICKETING_RATE_LIMIT_CREATE=70
TICKETING_RATE_LIMIT_ASSIGN=45
TICKETING_RATE_LIMIT_CLOSE=45
TICKETING_RATE_LIMIT_REPLY=55
TICKETING_RATE_WINDOW_READ=60
TICKETING_RATE_WINDOW_INDEX=60
TICKETING_RATE_WINDOW_SHOW=60
TICKETING_RATE_WINDOW_COMMENTS=60
TICKETING_RATE_WINDOW_WRITE=60
TICKETING_RATE_WINDOW_CREATE=60
TICKETING_RATE_WINDOW_ASSIGN=30
TICKETING_RATE_WINDOW_CLOSE=30
TICKETING_RATE_WINDOW_REPLY=30

